# =========================================================================
# Harlan's Legacy — environment configuration
#
# LOCAL DEV: you do NOT need any of these. With none set, the app runs exactly
# as before — server.js + build.js use the local data/*.json files.
#
# PRODUCTION (Vercel): set these as Vercel Environment Variables (Project →
# Settings → Environment Variables). NEVER commit real values; NEVER put the
# service-role key in browser/client code — it is used server-side only.
# =========================================================================

# ---- Supabase (server-side only) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# ---- Admin API authentication ----
# Any long random secret. The /admin app prompts for it and sends it as the
# x-admin-token header. Without it (or with the wrong value) the API returns 401
# and the admin shows a clear "Unauthorized" message instead of "0 memories".
ADMIN_TOKEN=change-me-to-a-long-random-secret

# ---- Rebuild trigger ----
# Vercel → Project → Settings → Git → Deploy Hooks → create one (e.g. "publish"
# on branch main) and paste its URL here. Saving/publishing a memory calls this
# to rebuild the public static site from the current Supabase data.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/XXXXXXXX/YYYYYYYY
